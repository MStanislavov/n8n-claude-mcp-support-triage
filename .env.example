# Required. Your Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Claude model id used by the agent.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Host ports, in case 8000 or 5678 are already in use on your machine.
# If you change N8N_HOST_PORT, also set N8N_URL for scripts/smoke.sh (default http://localhost:5678).
MCP_HOST_PORT=8000
